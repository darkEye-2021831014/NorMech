# Supabase project — find these in Project Settings → API
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Admin password — paste this into the admin login form
ADMIN_PASSWORD="choose-a-strong-password"

# JWT signing secret — any long random string, at least 32 chars recommended
SESSION_SECRET="change-me-to-a-long-random-string-at-least-16-chars"

# Production URL used to build the OpenGraph metadataBase. Set this
# on Vercel to your deployed URL, e.g. https://normech.vercel.app.
# Leave unset in dev — it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://YOUR-DEPLOYED-URL"
